void UpdateDashboard() {
   datetime cur = TimeCurrent();
   double dPL = GetDailyRealizedProfit(), dWR = GetDailyWinRate(); 
   int aPos = GetActivePositionsCount();
   int buyPos = 0, sellPos = 0; GetSpecificPositionsCount(buyPos, sellPos);
   int currentSpread = (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);

   UpdateLabel("ValTime", ": " + TimeToString(cur, TIME_SECONDS));
   UpdateLabel("ValActive", ": " + IntegerToString(aPos), (aPos > 0 ? InpPosColor : clrWhite)); 
   
   long remainingSeconds = EXPIRED_DATE - cur;
   int remainingDays = 0;
   string expText = "";
   if(remainingSeconds > 0) {
      remainingDays = (int)(remainingSeconds / 86400);
      expText = ": " + TimeToString(EXPIRED_DATE, TIME_DATE) + " (" + IntegerToString(remainingDays) + " hari)";
   } else {
      expText = ": EXPIRED (0 hari)";
   }
   UpdateLabel("ValExp", expText);

   if(cur >= EXPIRED_DATE) { 
      g_IsSystemHalted = true; 
      g_LastErrorMessage = "EXPIRED: Update Required";
   } 
   
   color sCol = clrLime; string sTxt = ": OPERATIONAL";
   if(g_IsSystemHalted) { sCol = clrRed; sTxt = ": HALTED"; } 
   else if(g_WeekendHalted) { sCol = clrOrange; sTxt = ": PAUSE (WEEKEND/HOLIDAY)"; }
   else if(g_PendingPause) { sCol = clrOrange; sTxt = ": PAUSE (PENDING STOP)"; }
   else if(g_ScheduleHalted) { sCol = clrOrange; sTxt = ": SCHEDULE OFF"; }
   else if(g_DailyLimitHit) { sCol = clrOrange; sTxt = ": DAILY LIMIT"; } 
   else if(g_LowBalance) { sCol = clrRed; sTxt = ": LOW MARGIN"; } 
   else if(g_MarketClosed) { sCol = clrYellow; sTxt = ": CLOSED"; } 
   
   if(g_EAMode == MODE_ALL) sTxt += " (ALL)";
   else if(g_EAMode == MODE_BUY_ONLY) sTxt += " (BUY ONLY)";
   else if(g_EAMode == MODE_SELL_ONLY) sTxt += " (SELL ONLY)";
   ObjectSetInteger(0, prefix+"BtnModeAll", OBJPROP_BGCOLOR, (g_EAMode == MODE_ALL ? clrSteelBlue : clrDarkGray));
   ObjectSetInteger(0, prefix+"BtnModeBuy", OBJPROP_BGCOLOR, (g_EAMode == MODE_BUY_ONLY ? clrLimeGreen : clrDarkGray));
   ObjectSetInteger(0, prefix+"BtnModeSell", OBJPROP_BGCOLOR, (g_EAMode == MODE_SELL_ONLY ? clrCrimson : clrDarkGray));

   UpdateLabel("ValStat", sTxt, sCol);
   
   string displayMsg = g_LastErrorMessage;
   UpdateLabel("ValErr", ": " + displayMsg, (g_LastErrorMessage == "System Ready" ? clrGray : InpMainColor));
   UpdateLabel("ValDaily", ": " + DoubleToString(dPL, 2) + " / $" + DoubleToString(InpDailyTargetUSD, 0), (dPL >= 0 ? clrLime : clrRed));
   UpdateLabel("ValWR", ": " + DoubleToString(dWR, 1) + " %", (dWR >= 50.0 ? clrLime : clrYellow));
   UpdateLabel("ValBal", ": " + DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2)); 
   UpdateLabel("ValEqt", ": " + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2));
   
   UpdateLabel("ValEMAStat", ": " + g_EMAStatus, (StringFind(g_EMAStatus, "BULLISH") >= 0 ? clrLime : (StringFind(g_EMAStatus, "BEARISH") >= 0 ? clrCrimson : clrYellow)));
   UpdateLabel("ValFastEMA", ": " + DoubleToString(g_FastEMAVal, (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS)), clrAqua);
   UpdateLabel("ValSlowEMA", ": " + DoubleToString(g_SlowEMAVal, (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS)), clrYellow);
   
   UpdateLabel("ValBuyCount", ": " + IntegerToString(buyPos), (buyPos > 0 ? InpPosColor : clrWhite));
   UpdateLabel("ValSellCount", ": " + IntegerToString(sellPos), (sellPos > 0 ? InpPosColor : clrWhite));
   UpdateLabel("ValSpread", ": " + IntegerToString(currentSpread) + " (Max: " + IntegerToString(InpMaxSpread) + ")", (currentSpread <= InpMaxSpread ? clrAqua : clrRed)); 

   double tPL = 0;
   for(int i = PositionsTotal()-1; i >= 0; i--) {
      if(posInfo.SelectByIndex(i) && posInfo.Symbol() == _Symbol && posInfo.Magic() == InpMagicNumber) {
         tPL += posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      }
   }
   UpdateLabel("ValPL", DoubleToString(tPL, 2) + " USD", (tPL >= 0 ? InpPosColor : InpNegColor));
   
   // Paksa penyegaran chart secara realtime tiap detik
   ChartRedraw(0);
}

void CreateLabel(string n, string t, int x, int y, color c, int s, string f="Arial") {
   if(ObjectFind(0, prefix+n) < 0) ObjectCreate(0, prefix+n, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix+n, OBJPROP_XDISTANCE, x); ObjectSetInteger(0, prefix+n, OBJPROP_YDISTANCE, y); 
   ObjectSetInteger(0, prefix+n, OBJPROP_COLOR, c); ObjectSetInteger(0, prefix+n, OBJPROP_FONTSIZE, s); 
   ObjectSetString(0, prefix+n, OBJPROP_TEXT, t);
   ObjectSetString(0, prefix+n, OBJPROP_FONT, f); 
   ObjectSetInteger(0, prefix+n, OBJPROP_SELECTABLE, false); 
}

void UpdateLabel(string n, string t, color c = clrNONE) { 
   if(ObjectFind(0, prefix+n) >= 0) { 
      ObjectSetString(0, prefix+n, OBJPROP_TEXT, t);
      if(c != clrNONE) ObjectSetInteger(0, prefix+n, OBJPROP_COLOR, c); 
   } 
}

