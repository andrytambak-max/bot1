//+------------------------------------------------------------------+
//| RestoreIntegritySLTP: Memastikan Keamanan Posisi Aktif           |
//+------------------------------------------------------------------+
void RestoreIntegritySLTP() {
   if(!MQLInfoInteger(MQL_TRADE_ALLOWED)) return;
   
   double atrValues[];
   ArraySetAsSeries(atrValues, true);
   double currentATR = 0.0;
   if(g_atrHandle != INVALID_HANDLE && CopyBuffer(g_atrHandle, 0, 0, 1, atrValues) > 0) {
      currentATR = atrValues[0];
   }

   for(int i = PositionsTotal() - 1; i >= 0; i--) { 
      if(posInfo.SelectByIndex(i) && posInfo.Symbol() == _Symbol && posInfo.Magic() == InpMagicNumber) { 
         int dig = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
         
         double currentSL = posInfo.StopLoss();
         double currentTP = posInfo.TakeProfit();
         double priceOpen = posInfo.PriceOpen();
         double targetSL  = currentSL;
         double targetTP  = currentTP;
         
         if(targetSL <= 0) {
            if(posInfo.PositionType() == POSITION_TYPE_BUY) { 
               targetSL = NormalizeDouble(priceOpen - (currentATR * 2.0), dig);
            } else { 
               targetSL = NormalizeDouble(priceOpen + (currentATR * 2.0), dig);
            }
         }
         
         if(targetSL > 0) {
            double distSL = MathAbs(priceOpen - targetSL);
            if(posInfo.PositionType() == POSITION_TYPE_BUY) {
               targetTP = NormalizeDouble(priceOpen + (distSL * InpRewardRatio), dig);
            } else {
               targetTP = NormalizeDouble(priceOpen - (distSL * InpRewardRatio), dig);
            }
         }
         
         if((MathAbs(currentSL - targetSL) > _Point / 2.0 || MathAbs(currentTP - targetTP) > _Point / 2.0) && targetSL > 0 && targetTP > 0) {
            if(!trade.PositionModify(posInfo.Ticket(), targetSL, targetTP)) {
               g_LastErrorMessage = "Repair Fail: L/TP Integrity";
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| CalculatePreciseLot: Money Management Berbasis Risiko USD Statis|
//+------------------------------------------------------------------+
double CalculatePreciseLot(double entry, double sl) {
   double dist = MathAbs(entry - sl);
   if(dist < _Point) return SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double tv = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double ts = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(ts <= 0 || tv <= 0) return SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   
   double dynamicRisk = InpRiskAmount;
   double rawLot = dynamicRisk / ((dist / ts) * tv);
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   
   int lotDigits = 0;
   if(step > 0) {
      lotDigits = (int)MathRound(-MathLog10(step));
      if(lotDigits < 0) lotDigits = 0;
   }
   
   double finalLot = NormalizeDouble(MathMax(MathFloor((rawLot / step) + 1e-9) * step, minLot), lotDigits); 
   return (finalLot > maxLot) ? maxLot : finalLot; 
}

//+------------------------------------------------------------------+
//| CheckMarginSafe: Verifikasi Kecukupan Margin Sebelum Entry       |
//+------------------------------------------------------------------+
bool CheckMarginSafe(ENUM_ORDER_TYPE type, double lot) {
   double marginReq = 0;
   if(!OrderCalcMargin(type, _Symbol, lot, SymbolInfoDouble(_Symbol, (type == ORDER_TYPE_BUY ? SYMBOL_ASK : SYMBOL_BID)), marginReq)) return false; 
   return (AccountInfoDouble(ACCOUNT_MARGIN_FREE) > marginReq);
}

//+------------------------------------------------------------------+
//| AntiManualOrderFilter: Menghapus Gangguan Order Luar Sistem      |
//+------------------------------------------------------------------+
void AntiManualOrderFilter() {
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(posInfo.SelectByIndex(i) && posInfo.Symbol() == _Symbol && posInfo.Magic() != InpMagicNumber) {
         trade.PositionClose(posInfo.Ticket());
      }
   }
}

//+------------------------------------------------------------------+
//| GetDailyRealizedProfit: Hitung Realized Profit Berbasis Pair     |
//+------------------------------------------------------------------+
double GetDailyRealizedProfit() {
   double p = 0;
   HistorySelect(iTime(_Symbol, PERIOD_D1, 0), TimeCurrent());
   for(int i=HistoryDealsTotal()-1; i>=0; i--) { 
      ulong t = HistoryDealGetTicket(i);
      if(HistoryDealGetInteger(t, DEAL_MAGIC) == InpMagicNumber && 
         HistoryDealGetInteger(t, DEAL_ENTRY) == DEAL_ENTRY_OUT && 
         HistoryDealGetString(t, DEAL_SYMBOL) == _Symbol) {
         p += HistoryDealGetDouble(t, DEAL_PROFIT) + HistoryDealGetDouble(t, DEAL_COMMISSION) + HistoryDealGetDouble(t, DEAL_SWAP);
      }
   }
   return p; 
}

//+------------------------------------------------------------------+
//| GetDailyWinRate: Hitung Win Rate Berbasis Pair Secara Mandiri     |
//+------------------------------------------------------------------+
double GetDailyWinRate() {
   int total = 0, win = 0;
   HistorySelect(iTime(_Symbol, PERIOD_D1, 0), TimeCurrent());
   for(int i=HistoryDealsTotal()-1; i>=0; i--) { 
      ulong t = HistoryDealGetTicket(i);
      if(HistoryDealGetInteger(t, DEAL_MAGIC) == InpMagicNumber && 
         HistoryDealGetInteger(t, DEAL_ENTRY) == DEAL_ENTRY_OUT && 
         HistoryDealGetString(t, DEAL_SYMBOL) == _Symbol) { 
         total++;
         if(HistoryDealGetDouble(t, DEAL_PROFIT) > 0) win++;
      }
   }
   return (total > 0) ? NormalizeDouble(((double)win/(double)total)*100.0, 1) : 0.0;
}

void CheckAccountAndMarket() {
   if(AccountInfoDouble(ACCOUNT_EQUITY) < InpMinEquity) { 
      g_LowBalance = true;
      g_LastErrorMessage = "ALERT: Low Equity!";
   } else {
      g_LowBalance = false;
   }
   g_MarketClosed = (SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE) == SYMBOL_TRADE_MODE_DISABLED); 
   if(g_MarketClosed) g_LastErrorMessage = "Market Closed";
}

