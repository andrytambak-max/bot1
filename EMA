void OnChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam) {
   if(id == CHARTEVENT_OBJECT_CLICK && sparam == prefix+"BtnClose") { 
      g_LastErrorMessage = "Action: Force Closing All...";
      for(int i = PositionsTotal()-1; i >= 0; i--) {
         if(posInfo.SelectByIndex(i) && posInfo.Symbol() == _Symbol && posInfo.Magic() == InpMagicNumber) {
            trade.PositionClose(posInfo.Ticket());
         }
      }
      ObjectSetInteger(0, prefix+"BtnClose", OBJPROP_STATE, false); 
      PurgeMQL5CacheAndLogs();
   }
   
   if(id == CHARTEVENT_OBJECT_CLICK) {
      if(sparam == prefix+"BtnModeAll") {
         g_EAMode = MODE_ALL;
         g_LastErrorMessage = "Mode Set: All Strategies Enabled";
         ObjectSetInteger(0, prefix+"BtnModeAll", OBJPROP_STATE, false); 
         UpdateDashboard(); 
      }
      else if(spArgsIsBtnBuy(sparam)) {
         g_EAMode = MODE_BUY_ONLY;
         g_LastErrorMessage = "Mode Set: Buy Only";
         ObjectSetInteger(0, prefix+"BtnModeBuy", OBJPROP_STATE, false); 
         UpdateDashboard(); 
      }
      else if(sparam == prefix+"BtnModeSell") {
         g_EAMode = MODE_SELL_ONLY;
         g_LastErrorMessage = "Mode Set: Sell Only";
         ObjectSetInteger(0, prefix+"BtnModeSell", OBJPROP_STATE, false); 
         UpdateDashboard(); 
      }
   }
}

bool spArgsIsBtnBuy(string sparam) {
   return (sparam == prefix+"BtnModeBuy");
}
