{
   MqlDateTime sTime;
   TimeToStruct(TimeCurrent(), sTime);
   if(sTime.hour == 23 && sTime.min == 59) {
      datetime todayStart = iTime(_Symbol, PERIOD_D1, 0);
      if(todayStart > lastRefreshTime) {
         lastRefreshTime = todayStart;
         g_LastErrorMessage = "Daily Refresh: Data Cleared";
         Print("SRM v1.55: Daily Research Data Refreshed at 23:59. Symbol: ", _Symbol, ". Active Positions Retained.");
         ChartRedraw(0);
      }
   }
}

//+------------------------------------------------------------------+
//| CheckEMACrossoverAndExecute: Deteksi Fresh & Permanen EMA (v1.55)|
//+------------------------------------------------------------------+
void CheckEMACrossoverAndExecute()
{
   int currentSpread = (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD); 
   if(currentSpread > InpMaxSpread || currentSpread < 0) {
      g_LastErrorMessage = "Wait: High Spread (" + (string)currentSpread + ")";
      return; 
   }

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK); 
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   int dig = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS); 

   double fastVals[], slowVals[];
   ArraySetAsSeries(fastVals, true);
   ArraySetAsSeries(slowVals, true);
   
   // Ambil data bar index [1] dan [2] untuk memastikan persilangan permanen yang fresh pada bar baru [1]
   if(CopyBuffer(g_fastEmaHandle, 0, 0, 3, fastVals) <= 0 || CopyBuffer(g_slowEmaHandle, 0, 0, 3, slowVals) <= 0) {
      g_ErrorCounter++;
      return;
   }

   g_FastEMAVal = fastVals[0];
   g_SlowEMAVal = slowVals[0];

   if(fastVals[0] > slowVals[0])
      g_EMAStatus = "BULLISH (F > S)";
   else if(fastVals[0] < slowVals[0])
      g_EMAStatus = "BEARISH (F < S)";
   else
      g_EMAStatus = "NEUTRAL";

   bool buyCrossover  = (fastVals[2] <= slowVals[2] && fastVals[1] > slowVals[1]);
   bool sellCrossover = (fastVals[2] >= slowVals[2] && fastVals[1] < slowVals[1]);

   datetime currentBarTime = iTime(_Symbol, _Period, 1); 

   if(buyCrossover || sellCrossover)
   {
      if(currentBarTime != g_LastCrossoverBar)
      {
         g_LastCrossoverBar = currentBarTime;
         g_HasEnteredThisCross = false;
      }
   }

   if(!g_HasEnteredThisCross)
   {
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         if(posInfo.SelectByIndex(i) && posInfo.Symbol() == _Symbol && posInfo.Magic() == InpMagicNumber)
         {
            datetime posTime = (datetime)posInfo.Time();
            if(posTime >= currentBarTime && posTime < currentBarTime + PeriodSeconds(_Period))
            {
               g_HasEnteredThisCross = true;
               break;
            }
         }
      }
   }

   double atrValues[];
   ArraySetAsSeries(atrValues, true);
   if(CopyBuffer(g_atrHandle, 0, 0, 1, atrValues) <= 0) return;
   double currentATR = atrValues[0];

   if(buyCrossover && !g_HasEnteredThisCross)
   {
      if(g_EAMode == MODE_ALL || g_EAMode == MODE_BUY_ONLY)
      {
         double entryPrice = ask;
         double sl = NormalizeDouble(entryPrice - (currentATR * 2.0), dig);
         double tp = NormalizeDouble(entryPrice + (MathAbs(entryPrice - sl) * InpRewardRatio), dig);
         double lot = CalculatePreciseLot(entryPrice, sl);
         
         if(lot >= SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN) && CheckMarginSafe(ORDER_TYPE_BUY, lot))
         {
            if(trade.Buy(lot, _Symbol, entryPrice, sl, tp, "EMA_CROSS_BUY_V155"))
            {
               g_HasEnteredThisCross = true;
               g_LastErrorMessage = "Trade: Fresh Buy Cross Executed";
               g_ErrorCounter = 0;
            }
            else
            {
               g_ErrorCounter++;
               g_LastErrorMessage = "Instant Buy Error: " + (string)trade.ResultRetcode();
            }
         }
      }
   }

   if(sellCrossover && !g_HasEnteredThisCross)
   {
      if(g_EAMode == MODE_ALL || g_EAMode == MODE_SELL_ONLY)
      {
         double entryPrice = bid;
         double sl = NormalizeDouble(entryPrice + (currentATR * 2.0), dig);
         double tp = NormalizeDouble(entryPrice - (MathAbs(sl - entryPrice) * InpRewardRatio), dig);
         double lot = CalculatePreciseLot(entryPrice, sl);
         
         if(lot >= SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN) && CheckMarginSafe(ORDER_TYPE_SELL, lot))
         {
            if(trade.Sell(lot, _Symbol, entryPrice, sl, tp, "EMA_CROSS_SELL_V155"))
            {
               g_HasEnteredThisCross = true;
               g_LastErrorMessage = "Trade: Fresh Sell Cross Executed";
               g_ErrorCounter = 0;
            }
            else
            {
               g_ErrorCounter++;
               g_LastErrorMessage = "Instant Sell Error: " + (string)trade.ResultRetcode();
            }
         }
      }
   }
}

