int OnInit()
{
   prefix = "SRM_V155_" + _Symbol + "_";
   trade.SetExpertMagicNumber(InpMagicNumber); 
   trade.SetTypeFillingBySymbol(_Symbol);      
   
   g_EAMode = InpEAMode;
   
   g_atrHandle = iATR(_Symbol, _Period, InpATRPeriod);
   g_fastEmaHandle = iMA(_Symbol, _Period, InpFastEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
   g_slowEmaHandle = iMA(_Symbol, _Period, InpSlowEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
   
   if(g_atrHandle == INVALID_HANDLE || g_fastEmaHandle == INVALID_HANDLE || g_slowEmaHandle == INVALID_HANDLE)
   {
      Print("SRM v1.55 Error: Gagal menginisialisasi indikator ATR atau EMA.");
      return(INIT_FAILED);
   }
   
   lastRefreshTime = iTime(_Symbol, PERIOD_D1, 0);
   ObjectsDeleteAll(0, prefix); 
   CreateDashboard();               
   EventSetTimer(1); 
   g_LastTickTime = TimeCurrent();
   g_LastTickCounter = GetTickCount();
   return(INIT_SUCCEEDED);          
}

