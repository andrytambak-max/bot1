//+------------------------------------------------------------------+
//| ExecuteCoreLogic: Pusat Eksekusi Utama                           |
//+------------------------------------------------------------------+
void ExecuteCoreLogic()
{
   // [UPGRADE v1.55]: Pemulihan Mandiri (Self-Recovery) jika EA Freeze/Lag/Error
   PerformSelfRecoveryCheck();

   CheckWeekendAndHoliday();
   CheckTradingSchedule();
   CheckPendingStopOrderPause();
   CheckAccountAndMarket(); 
   MonitorAndResetSystem(); 

   // Update dashboard realtime tiap 1 detik tanpa menunggu tick baru
   UpdateDashboard();

   if(g_IsSystemHalted || g_ScheduleHalted || g_WeekendHalted || g_PendingPause) return; 
   
   if(!TerminalInfoInteger(TERMINAL_CONNECTED)) { 
      g_LastErrorMessage = "Err: Reconnecting...";
      return;
   }

   double dailyProfit = GetDailyRealizedProfit();
   g_DailyLimitHit = (dailyProfit >= InpDailyTargetUSD || dailyProfit <= -InpDailyLossUSD);
   if(g_DailyLimitHit) g_LastErrorMessage = "Daily Goal/Loss Reached";

   AntiManualOrderFilter();     
   RestoreIntegritySLTP();      
   CheckSlippageAndProtection();
   
   if(InpAutoEntry && !g_DailyLimitHit && !g_MarketClosed && !g_LowBalance && !g_IsSystemHalted && !g_ScheduleHalted && !g_WeekendHalted && !g_PendingPause) { 
      if(MQLInfoInteger(MQL_TRADE_ALLOWED) && AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)) {
         CheckEMACrossoverAndExecute();
      } else {
         g_LastErrorMessage = "Err: AutoTrade Disabled";
      }
   }
}

//+------------------------------------------------------------------+
//| PerformSelfRecoveryCheck: Deteksi Freeze & Error Mandiri         |
//+------------------------------------------------------------------+
void PerformSelfRecoveryCheck()
{
   // Deteksi Freeze berdasarkan jeda waktu waktu server atau jeda millisecond tick (misal > 30 detik tanpa tick/aktivitas timer berat)
   uint currentTickCount = GetTickCount();
   if((currentTickCount - g_LastTickCounter) > 35000) // 35 detik stall
   {
      g_LastErrorMessage = "Self-Recovery: Freeze Detected, Re-initializing handles...";
      Print("SRM v1.55 Warning: Freeze / Lag terdeteksi. Melakukan re-inisialisasi mandiri.");
      
      // Re-inisialisasi indikator aman tanpa merusak logika trading baku
      if(g_atrHandle != INVALID_HANDLE) IndicatorRelease(g_atrHandle);
      if(g_fastEmaHandle != INVALID_HANDLE) IndicatorRelease(g_fastEmaHandle);
      if(g_slowEmaHandle != INVALID_HANDLE) IndicatorRelease(g_slowEmaHandle);
      
      g_atrHandle = iATR(_Symbol, _Period, InpATRPeriod);
      g_fastEmaHandle = iMA(_Symbol, _Period, InpFastEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
      g_slowEmaHandle = iMA(_Symbol, _Period, InpSlowEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
      
      g_LastTickCounter = GetTickCount();
      g_ErrorCounter = 0;
   }
}

//+------------------------------------------------------------------+
//| CheckWeekendAndHoliday: Filter Hari Libur & Sabtu-Minggu Pause   |
//+------------------------------------------------------------------+
void CheckWeekendAndHoliday()
{
   if(!InpUseHolidayFilter)
   {
      g_WeekendHalted = false;
      return;
   }

   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   
   // Hari Sabtu (6) atau Minggu (0)
   if(dt.day_of_week == 0 || dt.day_of_week == 6)
   {
      g_WeekendHalted = true;
      g_LastErrorMessage = "Mode Pause: Weekend (Sabtu/Minggu)";
      return;
   }

   // Deteksi Hari Libur Nasional / Tahun Baru / Natal sederhana berdasarkan tanggal kalender server (opsional tambahan presisi)
   // Format MM.DD (contoh: 1 Januari, 25 Desember)
   if((dt.mon == 1 && dt.day == 1) || (dt.mon == 12 && dt.day == 25))
   {
      g_WeekendHalted = true;
      g_LastErrorMessage = "Mode Pause: Hari Libur Nasional";
      return;
   }

   g_WeekendHalted = false;
}

//+------------------------------------------------------------------+
//| CheckPendingStopOrderPause: Pintasan Pause via Pending Stop Order|
//+------------------------------------------------------------------+
void CheckPendingStopOrderPause()
{
   bool stopOrderFound = false;
   
   // Memindai seluruh pending order di akun (pair manapun, lot berapapun)
   int totalOrders = OrdersTotal();
   for(int i = totalOrders - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket > 0)
      {
         ENUM_ORDER_TYPE oType = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
         // Deteksi tipe pending STOP order (BUY_STOP atau SELL_STOP)
         if(oType == ORDER_TYPE_BUY_STOP || oType == ORDER_TYPE_SELL_STOP)
         {
            stopOrderFound = true;
            break;
         }
      }
   }

   if(stopOrderFound)
   {
      g_PendingPause = true;
      g_LastErrorMessage = "Mode Pause: Pending Stop Order Detected!";
   }
   else
   {
      g_PendingPause = false;
   }
}

//+------------------------------------------------------------------+
//| CheckTradingSchedule: Validasi Jam Server dengan Jadwal Input    |
//+------------------------------------------------------------------+
void CheckTradingSchedule()
{
   if(!InpUseSchedule)
   {
      g_ScheduleHalted = false;
      return;
   }

   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   int currentMinutes = (int)(dt.hour * 60 + dt.min);

   int startHour = (int)StringSubstr(InpTimeStart, 0, 2);
   int startMin  = (int)StringSubstr(InpTimeStart, 3, 2);
   int startMinutes = (int)(startHour * 60 + startMin);

   int stopHour  = (int)StringSubstr(InpTimeStop, 0, 2);
   int stopMin   = (int)StringSubstr(InpTimeStop, 3, 2);
   int stopMinutes = (int)(stopHour * 60 + stopMin);

   if(startMinutes <= stopMinutes)
   {
      if(currentMinutes < startMinutes || currentMinutes >= stopMinutes)
      {
         g_ScheduleHalted = true;
         g_LastErrorMessage = "Schedule: Off (Outside Active Hours)";
      }
      else
      {
         g_ScheduleHalted = false;
      }
   }
   else 
   {
      if(currentMinutes >= stopMinutes && currentMinutes < startMinutes)
      {
         g_ScheduleHalted = true;
         g_LastErrorMessage = "Schedule: Off (Outside Active Hours)";
      }
      else
      {
         g_ScheduleHalted = false;
      }
   }
}

