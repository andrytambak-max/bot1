//| ScanAndKillManualOrders                                          |
//+------------------------------------------------------------------+
void ScanAndKillManualOrders() {
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionSelectByTicket(ticket)) {
         if(PositionGetString(POSITION_SYMBOL) == _Symbol && 
            PositionGetInteger(POSITION_MAGIC) != MAGIC_NUMBER) {
            
            if(currentTradeMode != MODE_BOTH) {
               currentTradeMode = MODE_BOTH;
               Print("GGR [", _Symbol, "]: Manual order terdeteksi! Auto-switch ke TRADING MODE BOTH (Hedging).");
            }
            
            trade.PositionClose(ticket);
         }
      }
   }
}

//+------------------------------------------------------------------+
//| CalibratedExecute                                                |
//+------------------------------------------------------------------+
bool CalibratedExecute(ENUM_ORDER_TYPE type, double lot, string comment) {
   // PENGECEKAN KEAMANAN EKSTRIM: Blokir total jika mencoba eksekusi SELL di mode BUY ONLY atau BUY di mode SELL ONLY
   if(currentTradeMode == MODE_BUY_ONLY && (type == ORDER_TYPE_SELL || type == ORDER_TYPE_SELL_LIMIT || type == ORDER_TYPE_SELL_STOP)) return false;
   if(currentTradeMode == MODE_SELL_ONLY && (type == ORDER_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP)) return false;

   MqlTick tick;
   if(!SymbolInfoTick(_Symbol, tick)) return false;
   double price = (type == ORDER_TYPE_BUY) ? tick.ask : tick.bid;
   double sl = 0;
   double tp = 0;
   
   ResetLastError();
   bool res = trade.PositionOpen(_Symbol, type, lot, NormalizeDouble(price, _Digits), sl, tp, comment);
   if(!res && DebugMode) {
      Print("GGR [", _Symbol, "]: Execution failed for ", comment, " Error code: ", GetLastError());
   }
   return res;
}

