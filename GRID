//+------------------------------------------------------------------+
//| OnTick Main Logic                                                |
//+------------------------------------------------------------------+
void OnTick() {
   lastTickTime = TimeCurrent();
   lastTickSystemTimeMS = GetTickCount(); 
   ulong current_time_ms = GetMicrosecondCount() / 1000;
   
   //--- AUTOMATIC SYSTEM FREEZE RECOVERY CHECK
   CheckAndRecoverSystemFreeze();
   
   if(TimeCurrent() >= INTERNAL_EXPIRY) {
      if(!isExpired) { 
         isExpired = true;
         ExecuteCloseAllStrategy(-1); 
      }
      return;
   }

   // --- ENFORCE STRICT MODE CONSTRAINTS FIRST ---
   EnforceModeConstraints();

   // --- PINTASAN SWIPE MODE & PENDING LIMIT DYNAMIC LOT (FULL INDEPENDENT PER PAIR) ---
   CheckAndHandlePendingLimitModes();

   // --- PINTASAN STOP ORDER & PAUSE ALL (ISOLASI PER SYMBOL & TIMEFRAME) ---
   if(CheckAndHandlePendingStopOrders()) {
      static datetime lastStopWarn = 0;
      if(TimeCurrent() - lastStopWarn >= 5) {
         Print("GGR V2: [PAUSE ALL] Terdeteksi Pending Stop Order di ", _Symbol, "! EA menahan entry baru dan membersihkan posisi aktif.");
         lastStopWarn = TimeCurrent();
      }
      UpdateDashboardData();
      return; 
   }

   MqlTick t;
   if(!SymbolInfoTick(_Symbol, t)) return;
   
   //--- AUTO SWITCH LOGIC
   if(Auto_Switch_Price > 0 && !isModeSwitched && LastKnownPrice > 0) {
      if((t.bid >= Auto_Switch_Price && LastKnownPrice < Auto_Switch_Price) ||
         (t.bid <= Auto_Switch_Price && LastKnownPrice > Auto_Switch_Price)) {
         currentTradeMode = Target_Mode_After_Switch;
         isModeSwitched = true;
         Print("GGR [", _Symbol, "]: Price triggered! Mode switched to: ", EnumToString(currentTradeMode));
         EnforceModeConstraints();
      }
   }

   //--- TRIGGER CLOSE ALL LOGIC
   double currentPrice = t.bid;
   if(Trigger_CloseAll_Price > 0 && LastKnownPrice > 0) {
      if((currentPrice >= Trigger_CloseAll_Price && LastKnownPrice < Trigger_CloseAll_Price) ||
         (currentPrice <= Trigger_CloseAll_Price && LastKnownPrice > Trigger_CloseAll_Price)) {
         ExecuteCloseAllStrategy(-1);
         LastKnownPrice = currentPrice;
         return;
      }
   }
   LastKnownPrice = currentPrice;

   if(AntiManual) ScanAndKillManualOrders();
   
   int currentBuyCount = CountPositionsByType(POSITION_TYPE_BUY);
   int currentSellCount = CountPositionsByType(POSITION_TYPE_SELL);
   double profitBuy = CalculateProfitByType(POSITION_TYPE_BUY);
   double profitSell = CalculateProfitByType(POSITION_TYPE_SELL);
   
   //--- RESET SIKLUS SECARA INDEPENDEN PER PAIR
   if(currentBuyCount == 0 && buyCycleCompleted) {
      buyCycleCompleted = false;
      lastBuyExecutedPrice = 0;
      Print("GGR [", _Symbol, "]: Keranjang BUY kosong. Siklus BUY direset.");
   }
   if(currentSellCount == 0 && sellCycleCompleted) {
      sellCycleCompleted = false;
      lastSellExecutedPrice = 0;
      Print("GGR [", _Symbol, "]: Keranjang SELL kosong. Siklus SELL direset.");
   }

   //--- DYNAMIC LOT TARGET PROFIT EXECUTION (BUY & SELL INDEPENDENT)
   if(UseDynamicLotTP) {
      double baseLot = (BaseLotForTP > 0) ? BaseLotForTP : 0.01;
      if(currentBuyCount > 0 && currentTradeMode != MODE_SELL_ONLY) {
         double totalBuyLot = GetTotalVolumeByType(POSITION_TYPE_BUY);
         if(totalBuyLot > 0) {
            double targetBuyUSD = (totalBuyLot / baseLot) * TargetUSD_Per_BaseLot;
            if(profitBuy >= (targetBuyUSD - 0.00001)) {
               Print("GGR [", _Symbol, "]: Dynamic Lot TP BUY Tercapai! Profit: ", profitBuy, " USD >= Target: ", targetBuyUSD, " USD. Closing BUY...");
               ExecuteCloseAllStrategy(0);
               return;
            }
         }
      }

      if(currentSellCount > 0 && currentTradeMode != MODE_BUY_ONLY) {
         double totalSellLot = GetTotalVolumeByType(POSITION_TYPE_SELL);
         if(totalSellLot > 0) {
            double targetSellUSD = (totalSellLot / baseLot) * TargetUSD_Per_BaseLot;
            if(profitSell >= (targetSellUSD - 0.00001)) {
               Print("GGR [", _Symbol, "]: Dynamic Lot TP SELL Tercapai! Profit: ", profitSell, " USD >= Target: ", targetSellUSD, " USD. Closing SELL...");
               ExecuteCloseAllStrategy(1);
               return;
            }
         }
      }
   }

   //--- FAIL-SAFE BASKET REDUCTION PROTECTION PER TIPE POSISI
   if(currentBuyCount < lastBuyPositionCount && currentBuyCount > 0 && profitBuy > 0) {
      Print("GGR [", _Symbol, "]: Position BUY decreased with positive profit. Executing Fail-Safe Close BUY...");
      ExecuteCloseAllStrategy(0); 
      return;
   }
   lastBuyPositionCount = currentBuyCount;

   if(currentSellCount < lastSellPositionCount && currentSellCount > 0 && profitSell > 0) {
      Print("GGR [", _Symbol, "]: Position SELL decreased with positive profit. Executing Fail-Safe Close SELL...");
      ExecuteCloseAllStrategy(1); 
      return;
   }
   lastSellPositionCount = currentSellCount;

   //--- GLOBAL TARGET & CUTLOSS PROTECTION (KHUSUS SIMBOL INI)
   double totalPL = CalculateTotalProfit();
   if((DailyTargetUSD > 0 && totalPL >= DailyTargetUSD) || 
      (CutlossUSD > 0 && totalPL <= -MathAbs(CutlossUSD))) {
      Print("GGR [", _Symbol, "]: Global Target/Cutloss tercapai. Menjalankan Close All Total...");
      ExecuteCloseAllStrategy(-1);
      return;
   }

   //--- GRID EXECUTION LOGIC
   int buyCount = 0, sellCount = 0;
   double lastBuyLot = 0, lastSellLot = 0;
   CountTypePositions(buyCount, sellCount, lastBuyLot, lastSellLot);

   int currentSpread = (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   if(currentSpread > MaxSpread) return;
   
   double effectiveInitialLot = pendingLimitActive ? detectedPendingLot : InitialLot;

   //--- EKSEKUSI BUY ORDER (HANYA JIKA MODE BUKAN SELL_ONLY)
   if((currentTradeMode == MODE_BOTH || currentTradeMode == MODE_BUY_ONLY) && !buyCycleCompleted) {
      if(buyCount == 0) {
         if(current_time_ms - lastBuyOrderTimeMS >= 100) {
            if(!IsPriceTooClose(t.ask, AntiStackDist, POSITION_TYPE_BUY)) {
               if(CalibratedExecute(ORDER_TYPE_BUY, effectiveInitialLot, "GGR-START-BUY")) {
                  lastBuyOrderTimeMS = current_time_ms;
                  lastBuyExecutedPrice = t.ask;
               }
            }
         }
      } else if(buyCount > 0) {
         if(current_time_ms - lastBuyOrderTimeMS >= 100) {
            CheckLayeringByType(POSITION_TYPE_BUY, buyCount, t, sellCount);
         }
      }
   }

   //--- EKSEKUSI SELL ORDER (HANYA JIKA MODE BUKAN BUY_ONLY)
   if((currentTradeMode == MODE_BOTH || currentTradeMode == MODE_SELL_ONLY) && !sellCycleCompleted) {
      if(sellCount == 0) {
         if(current_time_ms - lastSellOrderTimeMS >= 100) {
            if(!IsPriceTooClose(t.bid, AntiStackDist, POSITION_TYPE_SELL)) {
               if(CalibratedExecute(ORDER_TYPE_SELL, effectiveInitialLot, "GGR-START-SELL")) {
                  lastSellOrderTimeMS = current_time_ms;
                  lastSellExecutedPrice = t.bid; 
               }
            }
         }
      } else if(sellCount > 0) {
         if(current_time_ms - lastSellOrderTimeMS >= 100) {
            CheckLayeringByType(POSITION_TYPE_SELL, sellCount, t, buyCount);
         }
      }
   }

   static datetime lastDashboardRefresh = 0;
   if(TimeCurrent() - lastDashboardRefresh >= 1) {
      UpdateDashboardData();
      lastDashboardRefresh = TimeCurrent();
   }
}

//+------------------------------------------------------------------+
//| EnforceModeConstraints - Memastikan Mode Buy/Sell Berjalan Ketat |
//+------------------------------------------------------------------+
void EnforceModeConstraints() {
   // Jika berada di mode BUY ONLY, hapus seluruh posisi aktif SELL dan pending order SELL (Limit/Stop)
   if(currentTradeMode == MODE_BUY_ONLY) {
      if(CountPositionsByType(POSITION_TYPE_SELL) > 0) {
         ExecuteCloseAllStrategy(1);
      }
      for(int i = OrdersTotal() - 1; i >= 0; i--) {
         ulong tkt = OrderGetTicket(i);
         if(tkt > 0 && OrderGetString(ORDER_SYMBOL) == _Symbol) {
            ENUM_ORDER_TYPE ot = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
            if(ot == ORDER_TYPE_SELL_LIMIT || ot == ORDER_TYPE_SELL_STOP) {
               trade.OrderDelete(tkt);
            }
         }
      }
   }
   // Jika berada di mode SELL ONLY, hapus seluruh posisi aktif BUY dan pending order BUY (Limit/Stop)
   else if(currentTradeMode == MODE_SELL_ONLY) {
      if(CountPositionsByType(POSITION_TYPE_BUY) > 0) {
         ExecuteCloseAllStrategy(0);
      }
      for(int i = OrdersTotal() - 1; i >= 0; i--) {
         ulong tkt = OrderGetTicket(i);
         if(tkt > 0 && OrderGetString(ORDER_SYMBOL) == _Symbol) {
            ENUM_ORDER_TYPE ot = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
            if(ot == ORDER_TYPE_BUY_LIMIT || ot == ORDER_TYPE_BUY_STOP) {
               trade.OrderDelete(tkt);
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| CheckAndHandlePendingLimitModes - Pintasan Swipe & Lot Dinamis   |
//+------------------------------------------------------------------+
bool CheckAndHandlePendingLimitModes() {
   bool hasBuyLimit = false;
   bool hasSellLimit = false;
   double buyLimitLotFound = 0.0;
   double sellLimitLotFound = 0.0;
   
   int totalOrders = OrdersTotal();
   for(int i = totalOrders - 1; i >= 0; i--) {
      ulong ticket = OrderGetTicket(i);
      if(ticket > 0) {
         ENUM_ORDER_TYPE oType = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
         string oSymbol = OrderGetString(ORDER_SYMBOL);
         if(oSymbol == _Symbol) {
            if(oType == ORDER_TYPE_BUY_LIMIT) {
               hasBuyLimit = true;
               buyLimitLotFound = OrderGetDouble(ORDER_VOLUME_INITIAL);
            }
            if(oType == ORDER_TYPE_SELL_LIMIT) {
               hasSellLimit = true;
               sellLimitLotFound = OrderGetDouble(ORDER_VOLUME_INITIAL);
            }
         }
      }
   }

   if(hasBuyLimit && hasSellLimit) {
      currentTradeMode = MODE_BOTH;
      pendingLimitActive = true;
      detectedPendingLot = buyLimitLotFound > 0 ? buyLimitLotFound : (sellLimitLotFound > 0 ? sellLimitLotFound : InitialLot);
   }
   else if(hasBuyLimit) {
      if(currentTradeMode != MODE_BUY_ONLY) {
         currentTradeMode = MODE_BUY_ONLY;
         Print("GGR [", _Symbol, "]: [SWIPE MODE] Buy Limit terdeteksi. Otomatis beralih ke BUY ONLY. Menolak/menutup seluruh posisi & order SELL.");
      }
      pendingLimitActive = true;
      detectedPendingLot = buyLimitLotFound;
      EnforceModeConstraints();
   }
   else if(hasSellLimit) {
      if(currentTradeMode != MODE_SELL_ONLY) {
         currentTradeMode = MODE_SELL_ONLY;
         Print("GGR [", _Symbol, "]: [SWIPE MODE] Sell Limit terdeteksi. Otomatis beralih ke SELL ONLY. Menolak/menutup seluruh posisi & order BUY.");
      }
      pendingLimitActive = true;
      detectedPendingLot = sellLimitLotFound;
      EnforceModeConstraints();
   }
   else {
      pendingLimitActive = false;
   }
   return pendingLimitActive;
}

//+------------------------------------------------------------------+
//| CheckAndHandlePendingStopOrders - Pintasan Stop Order & Close All|
//+------------------------------------------------------------------+
bool CheckAndHandlePendingStopOrders() {
   bool foundStop = false;
   int totalOrders = OrdersTotal();
   
   for(int i = totalOrders - 1; i >= 0; i--) {
      ulong ticket = OrderGetTicket(i);
      if(ticket > 0) {
         if(OrderGetString(ORDER_SYMBOL) == _Symbol) {
            ENUM_ORDER_TYPE oType = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
            if(oType == ORDER_TYPE_BUY_STOP || oType == ORDER_TYPE_SELL_STOP) {
               foundStop = true;
               break;
            }
         }
      }
   }

   if(foundStop) {
      hasPendingStopOrders = true;
      if(CountPositions() > 0) {
         ExecuteCloseAllStrategy(-1); 
      }
      return true;
   }
   
   hasPendingStopOrders = false;
   return false;
}

