//| CheckAndRecoverSystemFreeze - Self-Healing Pemulihan Otomatis     |
//+------------------------------------------------------------------+
void CheckAndRecoverSystemFreeze() {
   ulong currentTickCount = GetTickCount();
   if(currentTickCount - lastTickCountCheck > 30000) { 
      datetime currentTime = TimeCurrent();
      if(currentTime - lastFrozenCheckTime > 15) {
         Print("GGR [", _Symbol, "]: Peringatan Sistem Freeze/Lag Terdeteksi! Menjalankan Pemulihan Otomatis & Pembersihan Memory...");
         PurgeMetaTraderMemoryCache();
         PerformSelfHealingAndRefresh();
         lastFrozenCheckTime = currentTime;
      }
      lastTickCountCheck = currentTickCount;
   }
}

//+------------------------------------------------------------------+
//| ExecuteCloseAllStrategy - Metode Paralel (Asynchronous / Instan)  |
//+------------------------------------------------------------------+
void ExecuteCloseAllStrategy(int targetType = -1) {
   int maxAttempts = 20;
   int currentAttempt = 0;
   if(targetType == -1 || targetType == 0) buyCycleCompleted = true;
   if(targetType == -1 || targetType == 1) sellCycleCompleted = true;
   
   ulong start_timeout = GetMicrosecondCount() / 1000;
   
   // Aktifkan mode Asynchronous (Paralel / Instan) untuk eksekusi kilat tanpa jeda antrian broker
   trade.SetAsyncMode(true);
   
   while(CountPositionsByType(targetType == 0 ? POSITION_TYPE_BUY : (targetType == 1 ? POSITION_TYPE_SELL : -1)) > 0 && currentAttempt < maxAttempts) {
      currentAttempt++;
      if((GetMicrosecondCount() / 1000) - start_timeout > 12000) {
         Print("GGR [", _Symbol, "]: CRITICAL - Close All Timeout reached to prevent interface freeze.");
         break;
      }
      
      for(int i = PositionsTotal() - 1; i >= 0; i--) {
         ulong ticket = PositionGetTicket(i);
         if(ticket > 0 && PositionSelectByTicket(ticket)) {
             if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == MAGIC_NUMBER) {
               ENUM_POSITION_TYPE pType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
               if(targetType == -1 || (targetType == 0 && pType == POSITION_TYPE_BUY) || (targetType == 1 && pType == POSITION_TYPE_SELL)) {
                  trade.PositionClose(ticket, 250);
               }
            }
         }
      }
      if(CountPositionsByType(targetType == 0 ? POSITION_TYPE_BUY : (targetType == 1 ? POSITION_TYPE_SELL : -1)) > 0) {
         Sleep(30);
      }
   }
   
   // Kembalikan ke mode synchronous untuk verifikasi loop ketat akhir sampai benar-benar 0 / bersih
   trade.SetAsyncMode(false);
   int safetyLoop = 0;
   while(CountPositionsByType(targetType == 0 ? POSITION_TYPE_BUY : (targetType == 1 ? POSITION_TYPE_SELL : -1)) > 0 && safetyLoop < 15) {
      safetyLoop++;
      for(int i = PositionsTotal() - 1; i >= 0; i--) {
         ulong ticket = PositionGetTicket(i);
         if(ticket > 0 && PositionSelectByTicket(ticket)) {
            if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == MAGIC_NUMBER) {
               ENUM_POSITION_TYPE pType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
               if(targetType == -1 || (targetType == 0 && pType == POSITION_TYPE_BUY) || (targetType == 1 && pType == POSITION_TYPE_SELL)) {
                  trade.PositionClose(ticket, 300);
               }
            }
         }
      }
      Sleep(50);
   }

   PurgeMetaTraderMemoryCache();
   PerformSelfHealingAndRefresh();
   ClearSystemState(targetType);

   if(AutoPurgeLog) CleanTrashLogs();
   UpdateDashboardData();
   ChartNavigate(0, CHART_CURRENT_POS, 0);
   ChartRedraw(0);
}

