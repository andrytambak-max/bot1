   if(currentTradeMode == MODE_BUY_ONLY && type == POSITION_TYPE_SELL) return;
   if(currentTradeMode == MODE_SELL_ONLY && type == POSITION_TYPE_BUY) return;

   double lastPrice = 0, lastLot = 0;
   if(!GetLastPriceAndLotByType(type, lastPrice, lastLot)) return;
   
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   ENUM_ORDER_TYPE orderType = (type == POSITION_TYPE_BUY) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   string comment = "";
   bool canLayer = false;
   double targetPrice = (type == POSITION_TYPE_BUY) ? t.ask : t.bid;
   ulong current_time_ms = GetMicrosecondCount() / 1000;
   
   if(type == POSITION_TYPE_BUY && (current_time_ms - lastBuyOrderTimeMS < 100)) return;
   if(type == POSITION_TYPE_SELL && (current_time_ms - lastSellOrderTimeMS < 100)) return;

   ENUM_PHASE phaseNow = DeterminePhase(count);
   if(type == POSITION_TYPE_BUY) {
      if(buyPhase != phaseNow) buyPhase = phaseNow;
   } else {
      if(sellPhase != phaseNow) sellPhase = phaseNow;
   }

   if(MathAbs(targetPrice - lastPrice) >= StepPoints * point) {
      canLayer = true;
      comment = (type == POSITION_TYPE_BUY) ? "GGR-BI-BUY-" + IntegerToString(count + 1) : "GGR-BI-SELL-" + IntegerToString(count + 1);
   }

   if(canLayer && !IsPriceTooClose(targetPrice, AntiStackDist, type)) {
      MqlTick tick_now;
      if(SymbolInfoTick(_Symbol, tick_now)) {
         double proximityLot = GetProximityLotBySlippage(type, targetPrice);
         double baseLotForCalc = (proximityLot > 0) ? proximityLot : lastLot;
         
         ENUM_PHASE outPhase = PHASE_LINEAR;
         double nextLot = CalculateHybridLot(count, baseLotForCalc, outPhase);
         if(IsMarginEnough(nextLot, orderType)) {
            if(CalibratedExecute(orderType, nextLot, comment)) {
               if(type == POSITION_TYPE_BUY) {
                  lastBuyOrderTimeMS = current_time_ms;
                  lastBuyExecutedPrice = targetPrice;
               } else {
                  lastSellOrderTimeMS = current_time_ms;
                  lastSellExecutedPrice = targetPrice;
               }
            }
            return;
         }
      }
   }

   int totalActive = PositionsTotal();
   if(totalActive < 2) return; 

   double prices[];
   ArrayResize(prices, 0);
   int idx = 0;
   
   for(int i = 0; i < totalActive; i++) {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionSelectByTicket(ticket)) {
         if(PositionGetInteger(POSITION_MAGIC) == MAGIC_NUMBER && PositionGetString(POSITION_SYMBOL) == _Symbol) {
            if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == type) {
               ArrayResize(prices, idx + 1);
               prices[idx] = PositionGetDouble(POSITION_PRICE_OPEN);
               idx++;
            }
         }
      }
   }

   if(ArraySize(prices) > 1) {
      ArraySort(prices);
      for(int i = 0; i < ArraySize(prices) - 1; i++) {
         double gapDist = prices[i+1] - prices[i];
         if(gapDist >= (StepPoints * 1.5) * point) {
            double fillPrice = NormalizeDouble(prices[i] + (StepPoints * point), _Digits);

            if(MathAbs(targetPrice - fillPrice) <= AntiStackDist * point && !IsPriceTooClose(fillPrice, AntiStackDist, type)) {
               double baselineLot = GetProximityLotBySlippage(type, fillPrice);
               if(baselineLot == 0) GetClosestLotByPrice(type, fillPrice, baselineLot);
               
               if(baselineLot > 0) {
                  ENUM_PHASE outPhase = PHASE_LINEAR;
                  double fillLot = CalculateHybridLot(i + 1, baselineLot, outPhase);
                  if(IsMarginEnough(fillLot, orderType)) {
                     if(CalibratedExecute(orderType, fillLot, "GGR-FILL-" + ((type == POSITION_TYPE_BUY) ? "BUY" : "SELL"))) {
                        if(type == POSITION_TYPE_BUY) {
                           lastBuyOrderTimeMS = current_time_ms;
                           lastBuyExecutedPrice = targetPrice;
                        } else {
                           lastSellOrderTimeMS = current_time_ms;
                           lastSellExecutedPrice = targetPrice;
                        }
                     }
                     break;
                  }
               }
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| GetLotByExactPrice                                               |
//+------------------------------------------------------------------+
bool GetLotByExactPrice(ENUM_POSITION_TYPE type, double targetPrice, double &lot) {
   lot = 0;
   for(int i = 0; i < PositionsTotal(); i++) {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionSelectByTicket(ticket)) {
         if(PositionGetInteger(POSITION_MAGIC) == MAGIC_NUMBER && PositionGetString(POSITION_SYMBOL) == _Symbol) {
            if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == type) {
               if(MathAbs(PositionGetDouble(POSITION_PRICE_OPEN) - targetPrice) < 0.00001) {
                  lot = PositionGetDouble(POSITION_VOLUME);
                  return true;
               }
            }
         }
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| GetClosestLotByPrice                                             |
//+------------------------------------------------------------------+
bool GetClosestLotByPrice(ENUM_POSITION_TYPE type, double targetPrice, double &closestLot) {
   closestLot = 0;
   double minDelta = 999999.0;
   bool found = false;
   
   for(int i = 0; i < PositionsTotal(); i++) {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionSelectByTicket(ticket)) {
         if(PositionGetInteger(POSITION_MAGIC) == MAGIC_NUMBER && PositionGetString(POSITION_SYMBOL) == _Symbol) {
            if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == type) {
               double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
               double delta = MathAbs(openPrice - targetPrice);
               if(delta < minDelta) {
                  minDelta = delta;
                  closestLot = PositionGetDouble(POSITION_VOLUME);
                  found = true;
               }
            }
         }
      }
   }
   return found;
}

//+------------------------------------------------------------------+
//| GetLastPriceAndLotByType                                         |
//+------------------------------------------------------------------+
bool GetLastPriceAndLotByType(ENUM_POSITION_TYPE type, double &price, double &lot) {
   price = 0;
   lot = 0;
   datetime maxTime = 0;
   bool found = false;
   
   for(int i = 0; i < PositionsTotal(); i++) {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionSelectByTicket(ticket)) {
         if(PositionGetInteger(POSITION_MAGIC) == MAGIC_NUMBER && 
            PositionGetString(POSITION_SYMBOL) == _Symbol) {
            if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == type) {
               datetime posTime = (datetime)PositionGetInteger(POSITION_TIME);
               if(posTime > maxTime) {
                  maxTime = posTime;
                  price = PositionGetDouble(POSITION_PRICE_OPEN);
                  lot = PositionGetDouble(POSITION_VOLUME);
                  found = true;
               }
            }
         }
      }
   }
   return found;
}

//+------------------------------------------------------------------+
//| CalculateHybridLot                                               |
//+------------------------------------------------------------------+
double CalculateHybridLot(int count, double lastLot, ENUM_PHASE &phaseOut) {
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   
   if(stepLot <= 0) stepLot = 0.01;
   if(minLot <= 0)  minLot = 0.01;
   if(maxLot <= 0)  maxLot = 100.0;
   
   int volDigits = GetVolumeDigits(stepLot);
   
   ENUM_PHASE phase = DeterminePhase(count);
   phaseOut = phase;
   
   double calculatedLot = lastLot;
   if(calculatedLot <= 0) calculatedLot = InitialLot;
   
   if(phase == PHASE_EXPONENTIAL) {
      int offset = count - RecoveryThreshold;
      int multiplierSteps = 0;
      if(RecoveryLayerStep > 0 && offset >= 0) multiplierSteps = offset / RecoveryLayerStep + 1;
      calculatedLot = lastLot * MathPow(ExpMultiplier, (double)multiplierSteps);
      if(lastLot <= 0) calculatedLot = InitialLot * MathPow(ExpMultiplier, (double)multiplierSteps);
   }
   else { 
      int step = count / OrdersPerStep;
      calculatedLot = InitialLot + (step * LotStep);
      if(lastLot > calculatedLot) calculatedLot = lastLot;
   }
   
   if(calculatedLot > MaxLotLimit) calculatedLot = MaxLotLimit;
   if(calculatedLot > maxLot) calculatedLot = maxLot;
   if(calculatedLot < minLot) calculatedLot = minLot;
   
   calculatedLot = RoundToStep(calculatedLot, stepLot);
   calculatedLot = NormalizeDouble(calculatedLot, volDigits);
   
   if(calculatedLot > MaxLotLimit) calculatedLot = MaxLotLimit;
   if(calculatedLot > maxLot) calculatedLot = maxLot;
   if(calculatedLot < minLot) calculatedLot = minLot;
   
   calculatedLot = NormalizeDouble(calculatedLot, volDigits);
   return calculatedLot;
}

//+------------------------------------------------------------------+
//| GetVolumeDigits                                                  |
//+------------------------------------------------------------------+
int GetVolumeDigits(double stepLot) {
   if(stepLot <= 0) return(2);
   int digits = 0;
   double tmp = stepLot;
   while(tmp < 1.0 - 1e-12 && digits < 8) {
      tmp *= 10.0;
      digits++;
   }
   return digits;
}

//+------------------------------------------------------------------+
//| RoundToStep                                                      |
//+------------------------------------------------------------------+
double RoundToStep(double value, double stepLot) {
   if(stepLot <= 0) return(value);
   double steps = MathRound(value / stepLot);
   return steps * stepLot;
}

//+------------------------------------------------------------------+
//| DeterminePhase                                                   |
//+------------------------------------------------------------------+
ENUM_PHASE DeterminePhase(int count) {
   if(count >= RecoveryThreshold) return PHASE_EXPONENTIAL;
   return PHASE_LINEAR;
}
