      return(INIT_FAILED);
   }
   
   string symPrefix = _Symbol + "_";
   btnCloseName     = symPrefix + "GGR_BTN_CLOSE_ALL";
   btnCloseBuyName  = symPrefix + "GGR_BTN_CLOSE_BUY";
   btnCloseSellName = symPrefix + "GGR_BTN_CLOSE_SELL";
